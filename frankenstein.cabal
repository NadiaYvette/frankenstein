cabal-version:      3.0
name:               frankenstein
version:            0.1.0.0
license:            GPL-2.0-only
license-file:       LICENSE
synopsis:           Polyglot compiler: Haskell, Mercury, Rust via Koka Core + MLIR
build-type:         Simple

common warnings
    ghc-options: -Wall -Wno-unused-imports -Wno-orphans
    default-extensions: OverloadedStrings

library
    import:           warnings
    exposed-modules:
        Frankenstein.Core.Types
        Frankenstein.Core.KokaCore
        Frankenstein.Core.Perceus
        Frankenstein.Core.CycleAnalysis
        Frankenstein.Core.Evidence
        Frankenstein.Core.EvidenceEvv
        Frankenstein.Core.EffectOpt
        Frankenstein.Core.DeriveSelectors
        Frankenstein.Core.FlattenPatterns
        Frankenstein.Core.ElideConsumedDrops
        Frankenstein.Core.PromoteRecursiveLambdas
        Frankenstein.Core.ConsumingUses
        Frankenstein.Debug.PerceusCounts
        Frankenstein.Core.NormalizePatterns
        Frankenstein.Core.CpsConvert
        Frankenstein.Core.TypeCheck
        Frankenstein.Debug.DumpProgram
        Frankenstein.MlirEmit.PostProcess
        Frankenstein.Core.ConTags
        Frankenstein.Core.Linker
        Frankenstein.GhcBridge.Driver
        Frankenstein.GhcBridge.CoreTranslate
        Frankenstein.MercuryBridge.HldsParse
        Frankenstein.MercuryBridge.CoreTranslate
        Frankenstein.RustBridge.MirParse
        Frankenstein.RustBridge.CoreTranslate
        Frankenstein.KokaBridge.Driver
        Frankenstein.KokaBridge.CoreTranslate
        Frankenstein.PythonBridge.AstParse
        Frankenstein.PythonBridge.CoreTranslate
        Frankenstein.GoBridge.AstParse
        Frankenstein.GoBridge.CoreTranslate
        Frankenstein.FutharkBridge.Parser
        Frankenstein.FutharkBridge.CoreTranslate
        Frankenstein.SchemeBridge.Reader
        Frankenstein.SchemeBridge.CoreTranslate
        Frankenstein.SwiftBridge.AstParse
        Frankenstein.SwiftBridge.CoreTranslate
        Frankenstein.SwiftBridge.Driver
        Frankenstein.OCamlBridge.AstParse
        Frankenstein.OCamlBridge.CoreTranslate
        Frankenstein.OCamlBridge.Driver
        Frankenstein.ErlangBridge.AstParse
        Frankenstein.ErlangBridge.CoreTranslate
        Frankenstein.ErlangBridge.Driver
        Frankenstein.FSharpBridge.CoreTranslate
        Frankenstein.FSharpBridge.Driver
        Frankenstein.IdrisBridge.Parse
        Frankenstein.IdrisBridge.CoreTranslate
        Frankenstein.IdrisBridge.Driver
        Frankenstein.MlirEmit.Emitter
        Frankenstein.MlirEmit.Dialects
        Frankenstein.OrganIR.Consumer
        Frankenstein.OrganIR.Emitter
        OrganIR.Types
        OrganIR.Parse
        OrganIR.Json
    build-depends:
        base >= 4.17 && < 5,
        containers,
        text,
        bytestring,
        process,
        filepath,
        directory,
        mtl,
        transformers,
        temporary,
        ghc == 9.14.*,
        ghc-boot-th,
        koka,
        organ-ir
    hs-source-dirs:   src
    c-sources:
        runtime/kk_perceus_flag.c
    default-language: GHC2024

test-suite frankenstein-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    KOracle
                      BridgeBisim
    hs-source-dirs:   test
    build-depends:
        base >= 4.17 && < 5,
        frankenstein,
        tasty,
        tasty-hunit,
        tasty-quickcheck,
        QuickCheck,
        containers,
        text,
        process,
        temporary,
        directory,
        filepath
    default-language: GHC2024

executable frankenstein
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.17 && < 5,
        frankenstein,
        text,
        filepath
    hs-source-dirs:   app
    default-language: GHC2024

executable frankenstein-diff-tester
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.17 && < 5,
        QuickCheck,
        bytestring,
        process,
        temporary,
        directory,
        filepath,
        containers
    hs-source-dirs:   tools/diff-tester
    default-language: GHC2024
